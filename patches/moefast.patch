+            const long long mib = atoll(env_mib);
+            if (mib > 0) {
+                cparams.moe_cache_size = (size_t) mib * 1024 * 1024;
+                LLAMA_LOG_INFO("%s: moe-cache size overridden by LLAMA_MOE_CACHE_MIB = %lld MiB\n", __func__, mib);
+            }
+        }
+        if (cparams.moe_cache_size == (size_t) -1) {   // auto：按当前实测剩余显存
+            size_t vfree = 0, vtotal = 0;
